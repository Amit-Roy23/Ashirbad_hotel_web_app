generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Room {
  id           String      @id @default(cuid())
  number       String      @unique
  floor        String?     @default("1")
  type         String      @default("Non-AC") // AC | Non-AC | Deluxe | Deluxe AC | Suite
  capacity     Int         @default(2)
  rate         Float       @default(1000) // actual per-night rate
  status       String      @default("VACANT") // VACANT | OCCUPIED | MAINTENANCE | RESERVED
  housekeeping String      @default("CLEAN") // CLEAN | DIRTY | IN_PROGRESS
  notes        String?
  bookings     Booking[]
  foodOrders   FoodOrder[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt

  @@index([status])
  @@index([housekeeping])
  @@index([type])
}

model Guest {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String
  email     String?
  company   String?
  gst       String?
  address   String?
  idProof   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  bookings  Booking[]

  @@index([phone])
  @@index([name])
}

model Booking {
  id                String             @id @default(cuid())
  roomId            String
  guestId           String
  checkIn           DateTime           @default(now())
  checkOut          DateTime?          // expected checkout
  originalCheckOut  DateTime?          // original planned checkout at booking creation
  actualCheckOut    DateTime?
  days              Int                @default(1)
  autoExtendedDays  Int                @default(0)
  guestCount        Int                @default(1)
  ratePerDay        Float              // actual rate for this booking
  status            String             @default("ACTIVE") // ACTIVE | BOOKED | COMPLETED | CANCELLED
  paymentStatus     String             @default("UNPAID") // UNPAID | PARTIAL | PAID
  advance           Float              @default(0)
  isCorporate       Boolean            @default(false)
  notes             String?
  room              Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guest             Guest              @relation(fields: [guestId], references: [id], onDelete: Restrict)
  bills             Bill[]
  foodOrders        FoodOrder[]
  extensions        BookingExtension[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  @@index([roomId])
  @@index([guestId])
  @@index([status])
  @@index([paymentStatus])
  @@index([checkIn])
  @@index([checkOut])
  @@index([createdAt])
}

model BookingExtension {
  id           String   @id @default(cuid())
  bookingId    String
  type         String   // AUTO | MANUAL
  fromCheckOut DateTime
  toCheckOut   DateTime
  fromDays     Int
  toDays       Int
  reason       String?
  createdBy    String?  // 'SYSTEM' for AUTO
  approvedBy   String?
  createdAt    DateTime @default(now())
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Bill {
  id              String   @id @default(cuid())
  billNumber      String   @unique
  bookingId       String
  days            Int      @default(1)
  actualRoomTotal Float    // internal: actual rate x days
  billedRoomTotal Float    // printed on bill (can be custom corporate rate)
  roomNumber      String?  // text printed on the invoice as room number (defaults to booking.room.number if null)
  roomDescription String?  // text printed on the invoice as room description (defaults to room.type if null)
  gstPercent      Float    @default(0) // combined rate = cgstPercent + sgstPercent
  cgstPercent     Float    @default(0) // 0 | 2.5
  sgstPercent     Float    @default(0) // 0 | 2.5
  actualGst       Float    // GST printed on the customer invoice (calculated on customer-facing billed amount)
  internalGst     Float    @default(0) // hotel's internal accounting GST (calculated on actual room tariff)
  internalTotal   Float    @default(0) // hotel's internal accounting total (actual room + food + extra - disc + internalGst)
  foodTotal       Float    @default(0)
  extraCharges    Float    @default(0)
  discount        Float    @default(0)
  grandTotal      Float    // full customer-facing bill amount (taxable + billed GST, advance is NOT subtracted)
  payCash         Float    @default(0)
  payUpi          Float    @default(0)
  payCard         Float    @default(0)
  advanceApplied  Float    @default(0) // advance deducted from full grandTotal to compute payable amount
  previousDue     Float    @default(0) // unpaid balance of the guest's earlier bills added to this bill (included in grandTotal, not taxed)
  carriedFrom     String?  // JSON [{ id, billNumber, amount }] of earlier bills whose balance was moved here
  carriedForward  Float    @default(0) // part of this bill's balance moved into a later bill
  carriedToBillNumber String? // the later bill that now holds this bill's balance
  isCorporate     Boolean  @default(false)
  corporateName   String?
  gstNumber       String?
  createdBy       String?  // user name who created the bill
  approvedBy      String?  // manager who approved custom billing
  status          String   @default("FINAL") // DRAFT | FINAL
  notes           String?
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments        BillPayment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([bookingId])
  @@index([billNumber])
  @@index([status])
  @@index([createdAt])
  @@index([isCorporate])
}

model MenuItem {
  id         String      @id @default(cuid())
  name       String
  category   String      @default("Main Course")
  price      Float
  available  Boolean     @default(true)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt

  @@index([category])
  @@index([available])
}

model FoodOrder {
  id        String      @id @default(cuid())
  bookingId String?     // attached to in-house guest => can merge to room bill
  roomId    String?
  tableNo   String?     // walk-in restaurant table
  subtotal    Float     @default(0) // items total before GST (0 on old orders = same as total)
  cgstPercent Float     @default(0)
  sgstPercent Float     @default(0)
  taxAmount   Float     @default(0) // CGST + SGST charged on a restaurant (food) bill
  total     Float       @default(0) // amount payable = subtotal + taxAmount
  status    String      @default("PENDING") // PENDING | ADDED_TO_BILL | PAID | CANCELLED
  createdBy String?     // user who took the order
  notes     String?
  items     OrderItem[]
  booking   Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  room      Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@index([bookingId])
  @@index([roomId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String
  price      Float
  quantity   Int       @default(1)
  order      FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
}

model Staff {
  id        String         @id @default(cuid())
  name      String
  phone     String?
  role      String         @default("Staff") // Manager | Reception | Housekeeping | Chef | Guard | Other
  salary    Float          @default(0)
  joinDate  DateTime       @default(now())
  address   String?
  aadhaar   String?
  active    Boolean        @default(true)
  payments  StaffPayment[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  @@index([active])
  @@index([role])
}

model StaffPayment {
  id            String   @id @default(cuid())
  staffId       String
  type          String   // SALARY | ADVANCE | BONUS | DEDUCTION
  amount        Float
  method        String   @default("CASH") // CASH | UPI | CARD | BANK
  date          DateTime @default(now())
  recoveryNotes String?  // advance recovery / adjustment notes
  notes         String?
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([staffId])
  @@index([date])
  @@index([type])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  type        String   // INCOME | EXPENSE
  category    String   // ROOM_RENT | GST | FOOD | ADVANCE | SALARY | STAFF_ADVANCE | STAFF | PURCHASE | UTILITIES | MAINTENANCE | OTHER
  description String
  amount      Float
  method      String   @default("CASH") // CASH | UPI | CARD | SPLIT | BANK
  source      String   @default("MANUAL") // AUTO | MANUAL
  vendor      String?  // staff/vendor for expense filtering
  refId       String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([type])
  @@index([category])
  @@index([refId])
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  role      String   @default("RECEPTION") // ADMIN | MANAGER | RECEPTION
  pin       String   @default("0000")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([role])
  @@index([active])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model ExpenseCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CUSTOM_BILL | BILL_CREATE | BOOKING_CREATE | BOOKING_CANCEL | CHECKIN | CHECKOUT | EXTEND | CHANGE_ROOM | PAYMENT | ORDER | ORDER_PAID | USER_CREATE | USER_UPDATE | SETTINGS | STAFF_PAYMENT | LEDGER_INCOME | EXPENSE | BANQUET_CREATE | BANQUET_BILL | BANQUET_UPDATE
  entity    String   // Booking | Bill | Room | FoodOrder | Setting | User | StaffPayment | LedgerEntry | BanquetBooking | BanquetBill | BanquetHall
  entityId  String?
  details   String?  // human-readable summary
  userName  String?
  userRole  String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model BanquetHall {
  id          String           @id @default(cuid())
  name        String           @unique
  capacity    Int              @default(100)
  baseRate    Float            @default(15000)
  rateType    String           @default("PER_EVENT") // PER_EVENT | PER_DAY | PER_HOUR
  status      String           @default("AVAILABLE") // AVAILABLE | OCCUPIED | MAINTENANCE
  amenities   String?          // e.g. "AC, Stage, Projector, Sound & Mic, DJ Lighting"
  description String?
  bookings    BanquetBooking[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([status])
}

model BanquetBooking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  hallId          String
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerAddress String?
  companyName     String?
  gstNumber       String?
  eventName       String        // Wedding, Reception, Birthday, Conference, Seminar, etc.
  eventDate       DateTime
  endDate         DateTime?     // last day of a multi-day booking (eventDate + days - 1)
  days            Int           @default(1)
  slot            String        @default("EVENING") // MORNING | EVENING | FULL_DAY | CUSTOM
  startTime       String?       // "HH:MM" each day (preset slots store their fixed times)
  endTime         String?
  hallRatePerDay  Float         @default(0) // hall rent per day; hallRent = hallRatePerDay x days
  idProof         String?       // host Government ID (TYPE:NUMBER)
  guestCount      Int           @default(100)
  hallRent        Float         @default(0)
  foodRatePerPlate Float        @default(0)
  foodPackageName String?
  foodTotal       Float         @default(0)
  decorCharges    Float         @default(0)
  decorEnabled    Boolean       @default(true)
  extraCharges    Float         @default(0)
  discount        Float         @default(0)
  totalEstimated  Float         @default(0)
  advancePaid     Float         @default(0)
  status          String        @default("CONFIRMED") // ENQUIRY | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  paymentStatus   String        @default("UNPAID") // UNPAID | PARTIAL | PAID
  notes           String?
  createdBy       String?
  hall            BanquetHall   @relation(fields: [hallId], references: [id], onDelete: Restrict)
  bills           BanquetBill[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([hallId])
  @@index([eventDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerPhone])
  @@index([bookingNumber])
}

model BanquetBill {
  id               String         @id @default(cuid())
  billNumber       String         @unique
  banquetBookingId String
  eventDate        DateTime       @default(now())
  customerName     String
  customerPhone    String
  customerAddress  String?
  companyName      String?
  gstNumber        String?
  eventName        String
  hallName         String
  slot             String         @default("EVENING")
  guestCount       Int            @default(100)
  hallRent         Float          @default(0)
  foodCharges      Float          @default(0)
  decorCharges     Float          @default(0)
  soundAvCharges   Float          @default(0)
  extraCharges     Float          @default(0)
  discount         Float          @default(0)
  taxableAmount    Float          @default(0)
  gstPercent       Float          @default(18)
  cgstPercent      Float          @default(0)
  sgstPercent      Float          @default(0)
  gstAmount        Float          @default(0)
  grandTotal       Float          @default(0)
  advanceApplied   Float          @default(0)
  payCash          Float          @default(0)
  payUpi           Float          @default(0)
  payCard          Float          @default(0)
  payBank          Float          @default(0)
  paymentStatus    String         @default("PAID") // PAID | PARTIAL | UNPAID
  status           String         @default("FINAL") // DRAFT | FINAL
  notes            String?
  terms            String?
  createdBy        String?
  approvedBy       String?
  booking          BanquetBooking @relation(fields: [banquetBookingId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@index([banquetBookingId])
  @@index([billNumber])
  @@index([createdAt])
  @@index([status])
}

// ============ INVENTORY ============
model InventoryItem {
  id           String              @id @default(cuid())
  name         String              @unique
  category     String              @default("Housekeeping & Linen")
  unit         String              @default("pcs") // pcs | kg | ltr | pack | box | bottle | roll | ...
  stock        Float               @default(0) // current quantity in stock, only changed through movements
  reorderLevel Float               @default(0) // at or below this the item is "Low stock"
  avgCost      Float               @default(0) // weighted average purchase cost per unit
  location     String?             // store room, kitchen, ...
  notes        String?
  active       Boolean             @default(true) // false = archived (kept for history)
  movements    InventoryMovement[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  @@index([category])
  @@index([active])
}

model InventoryMovement {
  id              String        @id @default(cuid())
  itemId          String
  type            String        // OPENING | PURCHASE | ISSUE | WASTAGE | ADJUSTMENT
  quantity        Float         // signed change in stock: + in, - out
  balanceAfter    Float         // stock right after this entry
  unitCost        Float         @default(0)
  totalCost       Float         @default(0) // purchase amount, or value used / wasted / adjusted at average cost
  vendor          String?
  reference       String?       // supplier bill / challan number
  department      String?       // where it was used (Housekeeping, Kitchen, Room ...)
  roomNumber      String?
  method          String?       // payment mode of a purchase
  expenseRecorded Boolean       @default(false) // purchase also written to Expenses (ledger, category INVENTORY)
  note            String?
  createdBy       String?
  date            DateTime      @default(now())
  createdAt       DateTime      @default(now())
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([date])
  @@index([type])
}

// Every payment received on a room bill, on the date it was received (the bill totals
// payCash / payUpi / payCard are the sum of these rows)
model BillPayment {
  id        String   @id @default(cuid())
  billId    String
  date      DateTime @default(now())
  kind      String   // CHECKOUT | DUE | ADJUST (bill edited)
  cash      Float    @default(0)
  upi       Float    @default(0)
  card      Float    @default(0)
  amount    Float    @default(0)
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([date])
}
